{
  "story_id": "enchanted_forest_extended",
  "story_title": "BÜYÜLÜ ORMAN: SEVİMLİ DOSTLAR",
  "start_node_id": "page_1",
  "theme_color": "0xff4a148c",
  "nodes": {
    "page_1": {
      "id": "page_1",
      "speakerName": "Anlatıcı",
      "dialogueText": "Büyük, yeşil bir ormandasın. Önünde parlayan küçük bir ışık var. Yerde iki tatlı yol duruyor.[cite: 1]",
      "backgroundPath": "images/enchanted_forest/backgrounds/forest_entrance.jpg",
      "audioPath": "audio/forest_start.mp3",
      "characterSpritePath": null,
      "choices": [
        {
          "text": "Parlayan küçük ışığı takip et",
          "nextNodeId": "page_2",
          "backgroundPath": "images/enchanted_forest/backgrounds/bright_path_transition.jpg",
          "audioPath": "audio/effects/wisp_chime.mp3"
        },
        {
          "text": "Hışırdayan yeşil çalıya bak",
          "nextNodeId": "page_3",
          "backgroundPath": "images/enchanted_forest/backgrounds/dark_thicket_transition.jpg",
          "audioPath": "audio/effects/rustle_leaves.mp3"
        }
      ]
    },
    "page_2": {
      "id": "page_2",
      "speakerName": "Cici Elf",
      "dialogueText": "Merhaba çocuk! Bizim gizli köyümüze hoş geldin. Büyük Kalp Ağacı çok üzgün. Bize yardım eder misin?[cite: 1]",
      "backgroundPath": "images/enchanted_forest/backgrounds/elf_village.jpg",
      "audioPath": "audio/elf_theme.mp3",
      "characterSpritePath": "images/characters/elf_friendly.png",
      "choices": [
        {
          "text": "\"Evet, hemen yardım ederim!\" de",
          "nextNodeId": "page_4",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "\"Ağaç neden üzgün?\" diye sor",
          "nextNodeId": "page_5",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "Büyük dağa doğru yürü",
          "nextNodeId": "page_6",
          "backgroundPath": null,
          "audioPath": null
        }
      ]
    },
    "page_3": {
      "id": "page_3",
      "speakerName": "Anlatıcı",
      "dialogueText": "Çalıdan sevimli, küçük bir kuş yavrusu çıkıyor. Kanatlarını sallıyor. Sana karanlık bir mağarayı gösteriyor.[cite: 1]",
      "backgroundPath": "images/enchanted_forest/backgrounds/dark_thicket.jpg",
      "audioPath": "audio/griffin_chirp.mp3",
      "characterSpritePath": "images/characters/griffin_baby.png",
      "choices": [
        {
          "text": "Sevimli yavru kuş ile mağaraya gir",
          "nextNodeId": "page_7",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "Yavru kuşu sev ve eski yola dön",
          "nextNodeId": "page_8",
          "backgroundPath": null,
          "audioPath": null
        }
      ]
    },
    "page_4": {
      "id": "page_4",
      "speakerName": "Cici Elf",
      "dialogueText": "Çok teşekkürler! Çok cesursun. Al bu parlayan Güneş Taşını. O sana güzel bahçenin yolunu gösterecek.",
      "backgroundPath": "images/enchanted_forest/backgrounds/elf_village.jpg",
      "audioPath": null,
      "characterSpritePath": "images/characters/elf_friendly.png",
      "choices": [
        {
          "text": "Hemen güzel bahçeye git",
          "nextNodeId": "page_9",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "Önce köye gidip çanta al",
          "nextNodeId": "page_10",
          "backgroundPath": null,
          "audioPath": null
        }
      ]
    },
    "page_5": {
      "id": "page_5",
      "speakerName": "Cici Elf",
      "dialogueText": "Yaramaz bir büyücü köklere toz döktü. Ağacın yaprakları dökülüyor. Onu kurtarmak için temiz bir kalbe ihtiyacımız var.",
      "backgroundPath": "images/enchanted_forest/backgrounds/elf_village.jpg",
      "audioPath": null,
      "characterSpritePath": "images/characters/elf_concerned.png",
      "choices": [
        {
          "text": "Ağacı kurtarmayı kabul et",
          "nextNodeId": "page_4",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "Yaramaz büyücü ile konuşmak iste",
          "nextNodeId": "page_11",
          "backgroundPath": null,
          "audioPath": null
        }
      ]
    },
    "page_6": {
      "id": "page_6",
      "speakerName": "Anlatıcı",
      "dialogueText": "Dağa doğru yürüyorsun. Hava biraz soğuyor. Önünde taştan yapılmış eski bir köprü var.",
      "backgroundPath": "images/enchanted_forest/backgrounds/mountain_pass.jpg",
      "audioPath": "audio/mountain_wind.mp3",
      "characterSpritePath": null,
      "choices": [
        {
          "text": "Taş köprüden yavaşça geç",
          "nextNodeId": "page_12",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "Aşağıdaki çiçekli vadiye in",
          "nextNodeId": "page_13",
          "backgroundPath": null,
          "audioPath": null
        }
      ]
    },
    "page_7": {
      "id": "page_7",
      "speakerName": "Anlatıcı",
      "dialogueText": "Mağaranın içi çok renkli. Renkli mantarlar ışık saçıyor. Yerde kilitli, eski bir demir kutu duruyor.",
      "backgroundPath": "images/enchanted_forest/backgrounds/cavern.jpg",
      "audioPath": "audio/cave_drips.mp3",
      "characterSpritePath": "images/characters/griffin_baby.png",
      "choices": [
        {
          "text": "Kutuyu bir taşla açmaya çalış",
          "nextNodeId": "page_14",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "\"Açıl kutu açıl!\" de",
          "nextNodeId": "page_15",
          "backgroundPath": null,
          "audioPath": null
        }
      ]
    },
    "page_8": {
      "id": "page_8",
      "speakerName": "Anlatıcı",
      "dialogueText": "Yolda yürürken küçük bir kulübe görüyorsun. Bacasından komik, mor bir duman çıkıyor.",
      "backgroundPath": "images/enchanted_forest/backgrounds/witch_hut_exterior.jpg",
      "audioPath": null,
      "characterSpritePath": null,
      "choices": [
        {
          "text": "Kapıyı tıklatıp içeri gir",
          "nextNodeId": "page_16",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "Kulübenin yanındaki taş kuyuya bak",
          "nextNodeId": "page_17",
          "backgroundPath": null,
          "audioPath": null
        }
      ]
    },
    "page_9": {
      "id": "page_9",
      "speakerName": "Anlatıcı",
      "dialogueText": "Bahçede mor sarmaşıklar var. Büyük, yaşlı bir ağaç amca burada oturuyor ve canı yandığı için ağlıyor.",
      "backgroundPath": "images/enchanted_forest/backgrounds/corrupted_glade.jpg",
      "audioPath": "audio/battle_tension.mp3",
      "characterSpritePath": "images/characters/corrupted_ent.png",
      "choices": [
        {
          "text": "Ağaç amcaya yardım etmek için Güneş Taşını kullan",
          "nextNodeId": "page_18",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "Sarmaşıkları elinle temizle",
          "nextNodeId": "page_19",
          "backgroundPath": null,
          "audioPath": null
        }
      ]
    },
    "page_10": {
      "id": "page_10",
      "speakerName": "Demirci Elf",
      "dialogueText": "Al bu sihirli oyuncağı. Bu, yıldızlardan yapıldı. Kötü tozları hemen temizler. Onu iyi işler için kullan.",
      "backgroundPath": "images/enchanted_forest/backgrounds/elf_armory.jpg",
      "audioPath": null,
      "characterSpritePath": "images/characters/elf_smith.png",
      "choices": [
        {
          "text": "Teşekkür et ve bahçeye git",
          "nextNodeId": "page_19",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "Oyuncağı al ve dağa tırman",
          "nextNodeId": "page_6",
          "backgroundPath": null,
          "audioPath": null
        }
      ]
    },
    "page_11": {
      "id": "page_11",
      "speakerName": "Cici Elf",
      "dialogueText": "Konuşmak mı? Yaramaz büyücü dağdaki kulede yaşıyor. Bu zor olabilir ama sen çok akıllısın.",
      "backgroundPath": "images/enchanted_forest/backgrounds/elf_village.jpg",
      "audioPath": null,
      "characterSpritePath": "images/characters/elf_concerned.png",
      "choices": [
        {
          "text": "Dağdaki kuleye doğru yürü",
          "nextNodeId": "page_6",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "Fikrini değiştir ve bahçeye koş",
          "nextNodeId": "page_9",
          "backgroundPath": null,
          "audioPath": null
        }
      ]
    },
    "page_12": {
      "id": "page_12",
      "speakerName": "Anlatıcı",
      "dialogueText": "Köprüden neşeyle geçiyorsun. Köprü arkanda kalıyor. Şimdi büyük ve parlak kulenin önündesin.",
      "backgroundPath": "images/enchanted_forest/backgrounds/obsidian_tower_entrance.jpg",
      "audioPath": "audio/bridge_collapse.mp3",
      "characterSpritePath": null,
      "choices": [
        {
          "text": "Büyük kapıya tık tık yap",
          "nextNodeId": "page_20",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "Küçük pencereden içeri bak",
          "nextNodeId": "page_21",
          "backgroundPath": null,
          "audioPath": null
        }
      ]
    },
    "page_13": {
      "id": "page_13",
      "speakerName": "Anlatıcı",
      "dialogueText": "Vadi çok güzel. Burada beyaz zambaklar var. Tatlı bir Ruh Tilkisi sana bakıp gülümsüyor.",
      "backgroundPath": "images/enchanted_forest/backgrounds/moonlight_meadow.jpg",
      "audioPath": "audio/peaceful_spirit.mp3",
      "characterSpritePath": "images/characters/spirit_fox.png",
      "choices": [
        {
          "text": "Tatlı tilkiye el salla",
          "nextNodeId": "page_22",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "Yerden bir beyaz çiçek al ve yürü",
          "nextNodeId": "page_23",
          "backgroundPath": null,
          "audioPath": null
        }
      ]
    },
    "page_14": {
      "id": "page_14",
      "speakerName": "Anlatıcı",
      "dialogueText": "Taş kutuya çarpınca komik bir ses çıkıyor! Mağaradaki küçük, sevimli yarasalar uyanıyor ve uçuyor.",
      "backgroundPath": "images/enchanted_forest/backgrounds/cavern.jpg",
      "audioPath": "audio/explosion.mp3",
      "characterSpritePath": null,
      "choices": [
        {
          "text": "Hemen dışarıya, temiz havaya çık",
          "nextNodeId": "page_8",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "Bekle ve yarasalara \"merhaba\" de",
          "nextNodeId": "page_24",
          "backgroundPath": null,
          "audioPath": null
        }
      ]
    },
    "page_15": {
      "id": "page_15",
      "speakerName": "Anlatıcı",
      "dialogueText": "Kutu açılıyor. İçinden parlayan bir kum saati çıkıyor. Bu saat, oyunları baştan oynamanı sağlıyor.",
      "backgroundPath": "images/enchanted_forest/backgrounds/cavern_open_chest.jpg",
      "audioPath": "audio/magic_unlock.mp3",
      "characterSpritePath": null,
      "choices": [
        {
          "text": "Saati al ve Elf Köyüne götür",
          "nextNodeId": "page_2",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "Saati al ve mağarada biraz daha oyna",
          "nextNodeId": "page_25",
          "backgroundPath": null,
          "audioPath": null
        }
      ]
    },
    "page_16": {
      "id": "page_16",
      "speakerName": "Tonton Teyze",
      "dialogueText": "Kimin sesini duydum? Hoş geldin küçük çocuk. Benden tatlı bir şurup mu istiyorsun, yoksa masal mı?",
      "backgroundPath": "images/enchanted_forest/backgrounds/witch_hut_interior.jpg",
      "audioPath": null,
      "characterSpritePath": "images/characters/witch_neutral.png",
      "choices": [
        {
          "text": "Ağacı iyileştirecek tatlı şurubu sor",
          "nextNodeId": "page_26",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "Büyücü amcanın yerini sor",
          "nextNodeId": "page_27",
          "backgroundPath": null,
          "audioPath": null
        }
      ]
    },
    "page_17": {
      "id": "page_17",
      "speakerName": "Anlatıcı",
      "dialogueText": "Kuyuya bakıyorsun. İçinde su yok, renkli yıldızlar var. Bir ses senin adını neşeyle sesleniyor.",
      "backgroundPath": "images/enchanted_forest/backgrounds/wishing_well.jpg",
      "audioPath": "audio/portal_hum.mp3",
      "characterSpritePath": null,
      "choices": [
        {
          "text": "Yıldızlı kuyunun içine bak",
          "nextNodeId": "page_28",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "Geri dön ve ilk yola git",
          "nextNodeId": "page_1",
          "backgroundPath": null,
          "audioPath": null
        }
      ]
    },
    "page_18": {
      "id": "page_18",
      "speakerName": "Anlatıcı",
      "dialogueText": "Güneş Taşı çok güzel parlıyor. Mor sarmaşıklar gidiyor. Ağaç amca yeniden çok mutlu ve yeşil oluyor.",
      "backgroundPath": "images/enchanted_forest/backgrounds/cleansed_glade.jpg",
      "audioPath": "audio/heal_spell.mp3",
      "characterSpritePath": "images/characters/clean_ent.png",
      "choices": [
        {
          "text": "Ağaç amca ile gidip büyücü ile konuş",
          "nextNodeId": "page_29",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "Mutlu ol ve oyunu bitir (Son 1)",
          "nextNodeId": "page_30_ending_1",
          "backgroundPath": null,
          "audioPath": null
        }
      ]
    },
    "page_19": {
      "id": "page_19",
      "speakerName": "Anlatıcı",
      "dialogueText": "Sarmaşıkları çekiyorsun ama onlar çok inatçı. Ağaç amca yoruluyor ve yere oturuyor. Biraz dinlenmen gerek.",
      "backgroundPath": "images/enchanted_forest/backgrounds/corrupted_glade.jpg",
      "audioPath": "audio/combat_hit.mp3",
      "characterSpritePath": "images/characters/corrupted_ent.png",
      "choices": [
        {
          "text": "Güneş Taşını ağacın kalbine koy",
          "nextNodeId": "page_18",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "Bugünlük dinlen ve uyu (Son 2)",
          "nextNodeId": "page_30_ending_2",
          "backgroundPath": null,
          "audioPath": null
        }
      ]
    },
    "page_20": {
      "id": "page_20",
      "speakerName": "Büyücü Amca",
      "dialogueText": "Aman Allah'ım! Benim kuleme kim geldi? Küçük bir çocuk mu? Ağacı kurtarmak mı istiyorsun?",
      "backgroundPath": "images/enchanted_forest/backgrounds/throne_room.jpg",
      "audioPath": "audio/boss_theme.mp3",
      "characterSpritePath": "images/characters/sorcerer_angry.png",
      "choices": [
        {
          "text": "Ona komik bir bilmece sor",
          "nextNodeId": "page_29",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "Ona bir elma ikram et",
          "nextNodeId": "page_27",
          "backgroundPath": null,
          "audioPath": null
        }
      ]
    },
    "page_21": {
      "id": "page_21",
      "speakerName": "Anlatıcı",
      "dialogueText": "Kulenin alt odasına giriyorsun. Burada renkli boyalar ve büyük, mavi bir cam taş var.",
      "backgroundPath": "images/enchanted_forest/backgrounds/tower_basement.jpg",
      "audioPath": null,
      "characterSpritePath": null,
      "choices": [
        {
          "text": "Mavi cam taşı sil ve parlat",
          "nextNodeId": "page_30_ending_1",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "Güzel boyaları al ve vadiye git",
          "nextNodeId": "page_13",
          "backgroundPath": null,
          "audioPath": null
        }
      ]
    },
    "page_22": {
      "id": "page_22",
      "speakerName": "Ruh Tilkisi",
      "dialogueText": "Sen çok iyi bir çocuksun. Bu ormanı sevdin. Al bu görünmez yıldız tozunu, seni her zaman korusun.",
      "backgroundPath": "images/enchanted_forest/backgrounds/moonlight_meadow.jpg",
      "audioPath": "audio/blessing.mp3",
      "characterSpritePath": "images/characters/spirit_fox.png",
      "choices": [
        {
          "text": "Yıldız tozuyla kuleye git",
          "nextNodeId": "page_12",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "Elf Köyüne dönüp arkadaşlarına haber ver",
          "nextNodeId": "page_2",
          "backgroundPath": null,
          "audioPath": null
        }
      ]
    },
    "page_23": {
      "id": "page_23",
      "speakerName": "Anlatıcı",
      "dialogueText": "Çiçeği koparınca çayır biraz kararıyor. Tilki amca üzülüyor. Kendini boş bir tarlada buluyorsun.",
      "backgroundPath": "images/enchanted_forest/backgrounds/barren_wasteland.jpg",
      "audioPath": "audio/growl.mp3",
      "characterSpritePath": null,
      "choices": [
        {
          "text": "Eski güzel yolu bulmak için yürü",
          "nextNodeId": "page_6",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "Burada küçük bir çadır kur (Son 3)",
          "nextNodeId": "page_30_ending_3",
          "backgroundPath": null,
          "audioPath": null
        }
      ]
    },
    "page_24": {
      "id": "page_24",
      "speakerName": "Anlatıcı",
      "dialogueText": "Yarasalarla dans ediyorsun. Küçük kuş uçuyor ve sana sarı, parlak bir anahtar getirip veriyor.",
      "backgroundPath": "images/enchanted_forest/backgrounds/cavern.jpg",
      "audioPath": "audio/sword_break.mp3",
      "characterSpritePath": "images/characters/griffin_baby.png",
      "choices": [
        {
          "text": "Anahtarı demir kutuda dene",
          "nextNodeId": "page_15",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "Anahtarla kulübeye doğru koş",
          "nextNodeId": "page_8",
          "backgroundPath": null,
          "audioPath": null
        }
      ]
    },
    "page_25": {
      "id": "page_25",
      "speakerName": "Anlatıcı",
      "dialogueText": "Mağaranın altında temiz bir göl var. Büyük, kırmızı bir ejderha uyuyor. Burnundan komik baloncuklar çıkıyor.",
      "backgroundPath": "images/enchanted_forest/backgrounds/dragon_nest.jpg",
      "audioPath": "audio/dragon_snore.mp3",
      "characterSpritePath": "images/characters/sun_dragon.png",
      "choices": [
        {
          "text": "Ejderhayı uyandırıp arkadaş ol",
          "nextNodeId": "page_29",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "Yerden bir sarı taş al ve kaç",
          "nextNodeId": "page_17",
          "backgroundPath": null,
          "audioPath": null
        }
      ]
    },
    "page_26": {
      "id": "page_26",
      "speakerName": "Tonton Teyze",
      "dialogueText": "Tatlı şurup mu? Onun için bana vadideki beyaz çiçekten getirmen gerek. O zaman sana veririm.",
      "backgroundPath": "images/enchanted_forest/backgrounds/witch_hut_interior.jpg",
      "audioPath": null,
      "characterSpritePath": "images/characters/witch_neutral.png",
      "choices": [
        {
          "text": "Çiçeği bulmak için vadiye koş",
          "nextNodeId": "page_13",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "Kulübedeki diğer renkli şişelere bak",
          "nextNodeId": "page_16",
          "backgroundPath": null,
          "audioPath": null
        }
      ]
    },
    "page_27": {
      "id": "page_27",
      "speakerName": "Anlatıcı",
      "dialogueText": "Büyücü amca şaka yapıyor! Oda aynalarla doluyor. Her yerde kendi yüzünü görüyorsun. Çok komik!",
      "backgroundPath": "images/enchanted_forest/backgrounds/mirror_maze.jpg",
      "audioPath": "audio/evil_laughter.mp3",
      "characterSpritePath": null,
      "choices": [
        {
          "text": "Aynalara dokun ve çıkışı ara",
          "nextNodeId": "page_14",
          "backgroundPath": null,
          "audioPath": null
        },
        {
          "text": "Gözlerini kapatıp düz yürü (Son 4)",
          "nextNodeId": "page_30_ending_4",
          "backgroundPath": null,
          "audioPath": null
        }
      ]
    },
    "page_28": {
      "id": "page_28",
      "speakerName": "Anlatıcı",
      "dialogueText": "Kuyudan aşağı kayıyorsun ve pofuduk bir koltuğa düşüyorsun. Burası harika bir bilgisayar odası! Meğer bu bir oyunmuş!",
      "backgroundPath": "images/enchanted_forest/backgrounds/sci_fi_lab.jpg",
      "audioPath": "audio/computer_hum.mp3",
      "characterSpritePath": null,
      "choices": [
        {
          "text": "\"Oyunu Yeniden Başlat\" tuşuna bas",
          "nextNodeId": "page_1",
          "backgroundPath": null,
          "audioPath": null
